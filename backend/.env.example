# SudhaarAI Backend Environment Variables Example

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Sudhaar

# Secret Key for JWT Token Generation (Replace with a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Google Gemini API Key for AI Grievance Classification & Translation
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins (Comma-separated URLs allowed to access backend API)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com
